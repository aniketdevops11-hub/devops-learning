``` yaml
name: Docker CI/CD

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build-and-deploy:
    runs-on: self-hosted

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Build Docker image
        run: docker build -t devops-website:latest .

      - name: Deploy Docker container
        run: |
          docker rm -f devops-website-container 2>/dev/null || true
          docker run -d --name devops-website-container -p 8081:80 devops-website:latest

      - name: Verify website
        run: |
          sleep 5
          curl --fail http://localhost:8081
```
